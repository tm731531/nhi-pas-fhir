@page
@model IndexModel
@{
    ViewData["Title"] = "NHI 事前審查 — Demo";
    string OutcomeBadge(NhiPasFhir.Core.CqlOutcome o) => o switch
    {
        NhiPasFhir.Core.CqlOutcome.Pass => "bg-success",
        NhiPasFhir.Core.CqlOutcome.WouldBeRejected => "bg-danger",
        NhiPasFhir.Core.CqlOutcome.DataMissing => "bg-warning text-dark",
        _ => "bg-secondary",
    };
    string OutcomeText(NhiPasFhir.Core.CqlOutcome o) => o switch
    {
        NhiPasFhir.Core.CqlOutcome.Pass => "通過 (Pass)",
        NhiPasFhir.Core.CqlOutcome.WouldBeRejected => "會被核刪 (WouldBeRejected)",
        NhiPasFhir.Core.CqlOutcome.DataMissing => "缺資料待補件 (DataMissing)",
        _ => "未評估 (NotEvaluated)",
    };
    string ResourceHint(string t) => t switch
    {
        "Bundle" => "整份卷宗",
        "Claim" => "申請單本體(要申請什麼藥、診斷)",
        "Patient" => "病人",
        "Practitioner" => "醫師",
        "PractitionerRole" => "醫師的執業角色",
        "Organization" => "醫院 / 機構",
        "Coverage" => "健保身分",
        "Encounter" => "就醫事件",
        "Condition" => "診斷(ICD)",
        "Procedure" => "處置 / 手術",
        "Observation" => "檢驗 / 檢查結果",
        "MedicationRequest" => "用藥醫令",
        "DiagnosticReport" => "影像 / 病理報告",
        "Specimen" => "檢體",
        "ClaimResponse" => "核定回應",
        _ => "FHIR 資源",
    };
}

<div class="p-4 mb-4 rounded-3" style="background:#f0f4ff;border:1px solid #dce4ff;">
    <h1 class="h4 mb-2">健保事前審查 (TWPAS) — 送核 Demo</h1>
    <p class="mb-3">
        <strong>這是什麼:</strong>一個把「送健保審查前的申請」自動組成國際標準 FHIR 格式、
        並用<strong>健保官方的規則先自我對答案</strong>的示範。目的:<strong>該補的先補、會被退的先擋</strong>,少送冤枉件。
    </p>
    <div class="mb-3">
        <strong>怎麼用:</strong>
        <ol class="mb-0">
            <li>下面選一個<strong>案子</strong>(例:癌症藥物送核)</li>
            <li>勾<strong>「送 CQL 自查」</strong>(要看健保規則判決就勾;背後有一台規則引擎在跑)</li>
            <li>按<strong>「跑一次」</strong> → 看下面長出:組好的資料、檢查、三態判決</li>
        </ol>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 small">
        <span class="badge bg-primary">① 產</span><span>組出 FHIR Bundle</span>
        <span class="text-muted">→</span>
        <span class="badge bg-primary">② 驗</span><span>藥↔適應症檢查</span>
        <span class="text-muted">→</span>
        <span class="badge bg-primary">③ 查</span><span>官方 CQL 規則自查</span>
        <span class="text-muted">→</span>
        <span class="badge bg-primary">④ 送</span><span>送到(假)收件端</span>
        <span class="text-muted">→</span>
        <span class="badge bg-primary">⑤ 回</span><span>收件回應(審核中)</span>
        <span class="ms-1 text-muted">(③④ 勾選才示範;④ 送的是假收件端,非真健保)</span>
    </div>
    <div class="mt-3 small">
        看不懂上面在說什麼?→
        <a asp-page="/Learn">CQL &amp; FHIR 問答</a>(它是什麼)‧
        <a asp-page="/Wiring">CQL 怎麼串</a>(背後怎麼運作)
    </div>
</div>

<form method="post" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label fw-semibold">案子 (Case)</label>
            <select class="form-select" asp-for="SelectedCase">
                @foreach (var c in IndexModel.Cases)
                {
                    <option value="@c.Key">@c.Label</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="RunCql" id="runCql">
                <label class="form-check-label" for="runCql">③ 查:送 CQL 自查(需 :8095 引擎)</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="DoSubmit" id="doSubmit">
                <label class="form-check-label" for="doSubmit">④ 送:送到(假)健保收件端</label>
            </div>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">跑一次</button>
        </div>
    </div>
</form>

@if (Model.HasResult)
{
    <div class="alert @(Model.Blocked ? "alert-danger" : "alert-success") d-flex align-items-center">
        <strong class="me-2">@(Model.Blocked ? "⛔ 擋下 (Blocked)" : "✅ 放行 (Clear)")</strong>
        <span class="small">@Model.Advisory</span>
    </div>

    @if (Model.CqlError is not null)
    {
        <div class="alert alert-warning small">
            CQL 自查未執行(已改為只組裝):@Model.CqlError
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">驗 — 種子檢查 (drug ↔ indication)</div>
                <div class="card-body">
                    @if (Model.Findings.Count == 0)
                    {
                        <p class="text-muted mb-0">無 finding。</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var f in Model.Findings)
                            {
                                <li class="list-group-item px-0">
                                    <span class="badge @(f.Severity == "error" ? "bg-danger" : "bg-warning text-dark") me-2">@f.Severity</span>
                                    <code>@f.DrugCode</code> @(f.IndicationCode is null ? "" : $"↔ {f.IndicationCode}")
                                    <div class="small text-muted">@f.Message</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">查 — CQL 送前自查</div>
                <div class="card-body">
                    @if (Model.Cql is null || Model.Cql.Outcome == NhiPasFhir.Core.CqlOutcome.NotEvaluated)
                    {
                        <p class="mb-1"><span class="badge bg-secondary">未評估</span></p>
                        <p class="small text-muted mb-0">
                            @(Model.RunCql ? "此案無對應 CQL 規則,或引擎未回結果。" : "未勾選 CQL 自查。勾選並確保 :8095 server 有跑。")
                        </p>
                    }
                    else
                    {
                        <p class="mb-2"><span class="badge @OutcomeBadge(Model.Cql.Outcome)">@OutcomeText(Model.Cql.Outcome)</span></p>
                        @if (!string.IsNullOrEmpty(Model.Cql.RuleIds))
                        {
                            <p class="small mb-2">規則:<code>@Model.Cql.RuleIds</code></p>
                        }
                        <ul class="small mb-0">
                            @foreach (var r in Model.Cql.Reasons)
                            {
                                <li>@r</li>
                            }
                        </ul>
                        @if (Model.Cql.Outcome != NhiPasFhir.Core.CqlOutcome.Pass)
                        {
                            <div class="alert alert-info small mt-3 mb-0">
                                ⚠️ <strong>「送出去沒事」是陷阱:</strong>這些問題健保<u>收件當下不會擋</u>(POST 會成功、看似沒事),
                                是<strong>事後審查才核刪、把錢扣回去</strong>。<br>
                                送前自查(這一步)就是把「事後才會爆」的問題<strong>提前在送出前</strong>抓出來,先補齊再送 → 不被核刪。
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Submitted)
    {
        <div class="card mt-4 border-info">
            <div class="card-header fw-semibold">送 → 回 — 送到(假)健保收件端</div>
            <div class="card-body">
                <p class="mb-2">
                    <span class="badge @(Model.SubmitAccepted ? "bg-info text-dark" : "bg-danger")">
                        @(Model.SubmitAccepted ? "④ 已送出 · 收件端已收下" : "④ 送出失敗")
                    </span>
                    @if (Model.SubmitAccepted)
                    {
                        <span class="badge bg-warning text-dark ms-1">⑤ 回:@(Model.SubmitStatus) · 審核中</span>
                    }
                </p>
                <p class="small mb-2">@Model.SubmitMessage</p>
                @if (Model.SubmitAccepted)
                {
                    <div class="alert alert-warning small mb-2">
                        ⚠️ <strong>收下 ≠ 核准。</strong>收件端回的是 <code>queued(審核中)</code> —— 只是「受理了」;
                        真正的核定(核准 / 核刪 / 補件)是<strong>事後</strong>才有。這正是為什麼要在送之前先做 ③ 查。
                    </div>
                }
                @if (Model.SubmitResponseJson is not null)
                {
                    <details>
                        <summary class="mb-2" style="cursor:pointer">展開 健保回應 Bundle(ClaimResponse)</summary>
                        <pre style="max-height:420px; overflow:auto; background:#0d1117; color:#c9d1d9; padding:1rem; border-radius:.5rem;"><code>@Model.SubmitResponseJson</code></pre>
                    </details>
                }
            </div>
        </div>
    }

    <div class="card mt-4">
        <div class="card-header fw-semibold">FHIR 各個體制 — 這份 Bundle 裡的資源</div>
        <div class="card-body">
            <p class="small text-muted">
                一份 Bundle 是把一筆申請需要的所有資料「釘成一疊」。每一種 resourceType 是 FHIR 的一個「體制」,
                各司其職。這個案子用到:
            </p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var rc in Model.ResourceCounts)
                {
                    <span class="badge rounded-pill bg-light text-dark border" title="@ResourceHint(rc.Type)">
                        <strong>@rc.Type</strong> ×@rc.Count
                        <span class="text-muted">· @ResourceHint(rc.Type)</span>
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between">
            <span class="fw-semibold">產 — 組出的 FHIR Bundle</span>
            <span class="text-muted small">@Model.EntryCount entries</span>
        </div>
        <div class="card-body">
            <details>
                <summary class="mb-2" style="cursor:pointer">展開 Bundle JSON</summary>
                <pre style="max-height:520px; overflow:auto; background:#0d1117; color:#c9d1d9; padding:1rem; border-radius:.5rem;"><code>@Model.BundleJson</code></pre>
            </details>
        </div>
    </div>
}
