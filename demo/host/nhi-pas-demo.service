# systemd USER service so the demo stays up on :5099 (so the tunnel always has something to hit).
# Install (on <DEMO_HOST_IP>, as tom):
#   dotnet build ~/Desktop/nhi-pas-fhir/demo/NhiPasDemo        # produce the DLL
#   mkdir -p ~/.config/systemd/user
#   cp ~/Desktop/nhi-pas-fhir/demo/host/nhi-pas-demo.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nhi-pas-demo
#   systemctl --user status nhi-pas-demo      # should be active (running)
# (optional, so it runs without you being logged in:  sudo loginctl enable-linger tom )
[Unit]
Description=NHI PAS FHIR demo (Razor Pages) on :5099
After=network.target

[Service]
WorkingDirectory=%h/Desktop/nhi-pas-fhir/demo/NhiPasDemo
ExecStart=%h/.dotnet/dotnet %h/Desktop/nhi-pas-fhir/demo/NhiPasDemo/bin/Debug/net8.0/NhiPasDemo.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5099
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
